# Business service, production.

environment = "prod"

# Network placement. MUST match the platform's setting of the same name.
#
#   false — tasks in private subnets, egress through a NAT gateway.
#           Costs about $42/month (gateway plus data processing).
#   true  — tasks in public subnets with public IPs, no NAT gateway.
#           Still not reachable: the security group admits only the load
#           balancer. What it gives up is defence in depth — a compromised
#           task could reach the internet directly rather than through a
#           chokepoint you can watch.
#
# false is the safe default. Set true deliberately, knowing the trade.
tasks_in_public_subnets = false
cors_allowed_origins = ["https://app.karlo.co.id"]
fluentd_host         = "fluentd.karlo.internal"

# The busiest service: every order, shipment and invoice write.
task_cpu      = 512
task_memory   = 1024
desired_count = 1
min_capacity  = 1
max_capacity  = 8

extra_environment = [
  { name = "DB_NAME", value = "karlo_business" },
  { name = "DB_SSLMODE", value = "require" },
  { name = "NOTIFY_TIMEOUT", value = "5s" },
]

secrets = [
  { name = "DB_HOST", valueFrom = "SECRET_RDS:host::" },
  { name = "DB_USER", valueFrom = "SECRET_RDS:username::" },
  { name = "DB_PASSWORD", valueFrom = "SECRET_RDS:password::" },
  { name = "JWT_PUBLIC_KEY", valueFrom = "SECRET_JWT_PUBLIC" },
  { name = "SERVICE_TOKEN", valueFrom = "SECRET_TOKENS:business-service::" },
  { name = "ACCEPTED_SERVICE_TOKENS", valueFrom = "SECRET_TOKENS:all::" },
]

secret_arns = ["SECRET_RDS", "SECRET_JWT_PUBLIC", "SECRET_TOKENS"]

# The SECRET_* placeholders are Secrets Manager ARNs from platform-terraform's
# `secret_arns` output. Copy this file to prod.tfvars and substitute them; the
# copy is gitignored because the ARNs name where production credentials live.
